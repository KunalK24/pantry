// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id           String   @id @default(cuid())
  name         String
  description  String?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredients        RecipeIngredient[]
  plannedMeals       PlannedMeal[]
  groceryListRecipes GroceryListRecipe[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Ingredient {
  id   String @id @default(cuid())
  name String

  recipes RecipeIngredient[]
}

model RecipeIngredient {
  recipeId     String
  ingredientId String

  quantity String?
  unit     String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([recipeId, ingredientId])
}

model PantryItem {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  quantity       String?
  unit           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  groceryItems GroceryItem[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@index([userId])
}

model WeeklyPlan {
  id        String   @id @default(cuid())
  weekStart DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals                PlannedMeal[]
  importedGroceryLists GroceryList[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

model PlannedMeal {
  id           String @id @default(cuid())
  weeklyPlanId String
  recipeId     String
  dayOffset    Int
  position     Int

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([weeklyPlanId, dayOffset, position])
  @@index([recipeId])
}

model GroceryList {
  id                   String   @id @default(cuid())
  key                  String
  importedWeeklyPlanId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  importedWeeklyPlan WeeklyPlan?         @relation(fields: [importedWeeklyPlanId], references: [id], onDelete: SetNull)
  recipes            GroceryListRecipe[]
  items              GroceryItem[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, importedWeeklyPlanId])
}

enum GroceryRecipeSource {
  MANUAL
  WEEKLY_PLAN
}

enum AiJobType {
  RECIPE_IMPORT
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELED
}

model GroceryListRecipe {
  id            String              @id @default(cuid())
  groceryListId String
  recipeId      String
  source        GroceryRecipeSource

  groceryList GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  recipe      Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([groceryListId])
  @@index([recipeId])
}

model GroceryItem {
  id               String  @id @default(cuid())
  groceryListId    String
  pantryItemId     String?
  lineKey          String
  name             String
  baseQuantity     String
  baseUnit         String
  quantityOverride String?
  unitOverride     String?
  checked          Boolean @default(false)
  dismissed        Boolean @default(false)

  groceryList GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  pantryItem  PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)

  @@unique([groceryListId, lineKey])
  @@index([pantryItemId])
}

model AiJob {
  id              String      @id @default(cuid())
  type            AiJobType
  status          AiJobStatus @default(QUEUED)
  inputJson       Json?
  sourceType      String?
  resultJson      Json?
  errorCode       String?
  errorMessage    String?
  errorRetryable  Boolean?
  progressMessage String
  attemptsJson    Json?
  bullJobId       String?     @unique
  canceledAt      DateTime?
  completedAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@index([type, status])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  recipes      Recipe[]
  pantryItems  PantryItem[]
  weeklyPlans  WeeklyPlan[]
  groceryLists GroceryList[]
  aiJobs       AiJob[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
